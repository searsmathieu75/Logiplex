---
interface Props {
  size?: 'sm' | 'lg';
  class?: string;
}

const { size = 'sm', class: className = '' } = Astro.props;
const mark = size === 'sm' ? 'h-8 w-8' : 'h-11 w-11';
const word = size === 'sm' ? 'text-[1.7rem]' : 'text-4xl';
const uid = size === 'sm' ? 'sm' : 'lg';
---

<span class:list={['group inline-flex items-center gap-2.5', className]}>
  <svg class:list={[mark, 'shrink-0']} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id={`grad-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#20C997" />
        <stop offset="55%" stop-color="#00E5FF" />
        <stop offset="100%" stop-color="#3B82F6" />
      </linearGradient>
    </defs>

    <rect x="6" y="4" width="1.5" height="24" fill="currentColor" opacity="0.4" />
    <rect x="6" y="7" width="13" height="1.5" fill="currentColor" opacity="0.4" />
    <rect x="6" y="15.25" width="17" height="1.5" fill="currentColor" opacity="0.4" />
    <rect x="6" y="23.5" width="13" height="1.5" fill="currentColor" opacity="0.4" />

    <circle cx="19.5" cy="7.75" r="3" fill={`url(#grad-${uid})`}>
      <animate attributeName="r" values="3;3.7;3" dur="3.2s" repeatCount="indefinite" />
    </circle>
    <circle cx="23.5" cy="16" r="3" fill={`url(#grad-${uid})`}>
      <animate attributeName="r" values="3;3.7;3" dur="3.2s" begin="1.05s" repeatCount="indefinite" />
    </circle>
    <circle cx="19.5" cy="24.25" r="3" fill={`url(#grad-${uid})`}>
      <animate attributeName="r" values="3;3.7;3" dur="3.2s" begin="2.1s" repeatCount="indefinite" />
    </circle>
  </svg>

  <span class:list={['font-display leading-none tracking-tight texte-degrade', word]}>
    GoWifi
  </span>
</span>
