---
import { primaryNav, cta } from '../data/navigation';
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-50 border-b border-white/8 bg-charbon/72 backdrop-blur-xl">
  <div class="mx-auto max-w-[88rem] px-6 md:px-12">
    <div class="flex items-center justify-between gap-8 py-5 md:py-6">
      <a href="/" class="hover:text-liaison transition-colors" aria-label="GoWifi, accueil">
        <Logo size="sm" />
      </a>

      <!-- Navigation bureau -->
      <nav aria-label="Navigation principale" class="hidden md:block">
        <ul class="flex items-center gap-8">
          {
            primaryNav.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="relative text-sm font-medium text-technique/75 transition-colors hover:text-liaison after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-liaison after:transition-all hover:after:w-full"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={cta.href}
              class="bouton on-liaison px-5 py-2.5 text-sm"
            >
              {cta.label}
            </a>
          </li>
        </ul>
      </nav>

      <!-- Bouton menu mobile -->
      <button
        type="button"
        id="menu-toggle"
        class="md:hidden text-sm font-semibold uppercase tracking-widest text-technique"
        aria-expanded="false"
        aria-controls="menu-mobile"
      >
        <span data-menu-label>Ouvrir le menu</span>
      </button>
    </div>
  </div>

  <!-- Panneau mobile. Fermé par défaut côté serveur; sans JavaScript il
       n'est pas atteignable, ce qui est acceptable car chaque destination
       reste accessible depuis le pied de page. -->
  <nav
    id="menu-mobile"
    aria-label="Navigation mobile"
    class="md:hidden hidden border-t border-white/10 bg-charbon/95 backdrop-blur-xl"
  >
    <ul class="mx-auto max-w-[88rem] px-6 py-6 flex flex-col gap-1">
      {
        primaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              data-menu-link
              class="block py-3 text-xl font-display tracking-tight hover:text-liaison transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-4">
        <a
          href={cta.href}
          data-menu-link
          class="bouton on-liaison block px-5 py-3 text-center"
        >
          {cta.longLabel}
        </a>
      </li>
    </ul>
  </nav>
</header>
