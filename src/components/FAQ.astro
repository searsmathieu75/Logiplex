---
import { faq } from '../data/faq';
---

<!-- La FAQ est rendue ouverte côté serveur. interactions.ts retire .no-js
     puis referme les panneaux : sans JavaScript, tout le texte reste lisible. -->
<section id="faq" class="surface-sombre">
  <div class="mx-auto max-w-[88rem] px-6 md:px-12 py-24 md:py-32">
    <div class="grid grid-cols-4 md:grid-cols-12 gap-8 md:gap-12" data-reveal-groupe>
      <div class="col-span-4 md:col-span-3">
        <h2 class="section-label text-ambre" data-reveal>06 / Questions fréquentes</h2>
      </div>

      <div class="col-span-4 md:col-span-8">
        <p class="font-display text-section" data-reveal>
          Ce qu'il faut clarifier avant de confier les services d'un immeuble.
        </p>

        <div class="mt-16 space-y-3" data-reveal-groupe>
          {
            faq.map((entry, index) => (
              <div class="verre px-6" data-reveal style="--accent:#f59e0b">
                <h3>
                  <button
                    type="button"
                    data-faq-trigger
                    id={`faq-trigger-${index}`}
                    aria-expanded="true"
                    aria-controls={`faq-panel-${index}`}
                    class="w-full flex items-start justify-between gap-6 py-6 text-left"
                  >
                    <span class="font-display text-xl md:text-2xl leading-tight">
                      {entry.question}
                    </span>
                    <span
                      class="faq-chevron shrink-0 mt-1 text-ambre text-2xl leading-none transition-transform duration-300"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </button>
                </h3>
                <div
                  data-faq-panel
                  id={`faq-panel-${index}`}
                  role="region"
                  aria-labelledby={`faq-trigger-${index}`}
                >
                  <p class="pb-6 max-w-2xl text-technique/70">{entry.answer}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
