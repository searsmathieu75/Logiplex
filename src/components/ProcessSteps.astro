---
interface Step {
  readonly numero: string;
  readonly titre: string;
  readonly texte: string;
  readonly accent: string;
}

const steps: readonly Step[] = [
  {
    numero: '01',
    titre: 'Audit',
    accent: '#20c997',
    texte:
      "Nous recensons le nombre de portes, les services visés, le câblage existant et les contraintes d'accès.",
  },
  {
    numero: '02',
    titre: 'Devis',
    accent: '#00e5ff',
    texte:
      'Vous recevez un périmètre de travaux, la liste des services inclus et les responsabilités de chaque partie.',
  },
  {
    numero: '03',
    titre: 'Installation',
    accent: '#3b82f6',
    texte:
      "Nous coordonnons les passages, l'équipement et la mise en service avec la personne responsable de l'immeuble.",
  },
  {
    numero: '04',
    titre: 'Gestion continue',
    accent: '#8b5cf6',
    texte:
      'Après la mise en service, vous gardez un seul contact pour les services couverts par votre entente.',
  },
];
---

<section id="fonctionnement" class="surface-sombre">
  <div class="mx-auto max-w-[88rem] px-6 py-24 md:px-12 md:py-32">
    <div class="grid grid-cols-4 gap-8 md:grid-cols-12 md:gap-12" data-reveal-groupe>
      <div class="col-span-4 md:col-span-3">
        <h2 class="section-label text-cyan" data-reveal>04 / Déploiement</h2>
      </div>

      <div class="col-span-4 md:col-span-8">
        <p class="font-display text-section" data-reveal>
          Vous validez le plan <span class="texte-degrade">avant le début des travaux.</span>
        </p>

        <ol class="spine mt-16 space-y-6" data-reveal-groupe>
          {
            steps.map((step) => (
              <li class="spine-node" style={`--accent:${step.accent}`} data-reveal>
                <div class="verre p-6 md:p-8" data-tilt>
                  <div class="grid grid-cols-1 gap-4 md:grid-cols-12 md:gap-8">
                    <p
                      class="font-display text-4xl leading-none md:col-span-2"
                      style={`color:${step.accent}`}
                    >
                      {step.numero}
                    </p>
                    <div class="md:col-span-10">
                      <h3 class="font-display text-2xl leading-tight md:text-3xl">{step.titre}</h3>
                      <p class="mt-3 max-w-xl text-technique/70">{step.texte}</p>
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
