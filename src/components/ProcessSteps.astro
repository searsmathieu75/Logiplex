---
interface Step {
  readonly numero: string;
  readonly titre: string;
  readonly texte: string;
}

const steps: readonly Step[] = [
  {
    numero: '01',
    titre: 'Audit',
    texte:
      "Nous recensons le nombre de portes, les services visés, le câblage existant et les contraintes d'accès.",
  },
  {
    numero: '02',
    titre: 'Devis',
    texte:
      'Vous recevez un périmètre de travaux, la liste des services inclus et les responsabilités de chaque partie.',
  },
  {
    numero: '03',
    titre: 'Installation',
    texte:
      "Nous coordonnons les passages, l'équipement et la mise en service avec la personne responsable de l'immeuble.",
  },
  {
    numero: '04',
    titre: 'Gestion continue',
    texte:
      'Après la mise en service, vous gardez un seul contact pour les services couverts par votre entente.',
  },
];
---

<section id="fonctionnement" class="bg-technique text-charbon">
  <div class="mx-auto max-w-[88rem] px-6 md:px-12 py-24 md:py-32">
    <div class="grid grid-cols-4 md:grid-cols-12 gap-8 md:gap-12">
      <div class="col-span-4 md:col-span-3">
        <h2 class="section-label text-charbon/60">04 / Déploiement</h2>
      </div>

      <div class="col-span-4 md:col-span-8">
        <p class="font-display text-section">
          Vous validez le plan avant le début des travaux.
        </p>

        <ol class="spine mt-16 space-y-12">
          {
            steps.map((step) => (
              <li class="spine-node">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8">
                  <p class="font-display text-3xl leading-none text-charbon/25 md:col-span-2">
                    {step.numero}
                  </p>
                  <div class="md:col-span-10">
                    <h3 class="font-display text-2xl md:text-3xl leading-tight">{step.titre}</h3>
                    <p class="mt-3 max-w-xl text-charbon/75">{step.texte}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
