---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { contactInfo } from '../data/navigation';
---

<BaseLayout
  title="Contact | Réserver un appel de qualification — GoWifi"
  description="Réservez un appel de qualification avec GoWifi pour évaluer les services connectés de votre immeuble multilogements au Québec."
  path="/contact"
>
  <section class="bg-charbon text-technique">
    <div class="mx-auto max-w-[88rem] px-6 md:px-12 pt-20 pb-16 md:pt-28 md:pb-20">
      <div class="grid grid-cols-4 md:grid-cols-12 gap-8 md:gap-12">
        <div class="col-span-4 md:col-span-3">
          <p class="section-label text-liaison">Appel de qualification</p>
        </div>
        <div class="col-span-4 md:col-span-8">
          <h1 class="font-display text-section">
            Décrivez le bâtiment, nous vous dirons ce qui est réaliste.
          </h1>
          <p class="mt-8 max-w-2xl text-lg text-technique/75">
            L'appel sert à vérifier la taille de l'immeuble, les services visés et les
            contraintes existantes. Aucun devis n'est produit avant l'audit sur place.
          </p>
          <p class="mt-8 text-technique/75">
            Vous préférez le téléphone : {contactInfo.personne} au
            <a href={contactInfo.telephoneHref} class="text-liaison underline underline-offset-4">
              {contactInfo.telephone}
            </a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ContactForm showHeading={false} />
</BaseLayout>
