# URL canonique du site, sans barre oblique finale.
# Utilisée pour le canonical, l'Open Graph, le sitemap et le JSON-LD.
PUBLIC_SITE_URL="https://monwifi.pages.dev"

# Endpoint POST du formulaire de contact.
# Tant que cette variable est vide, le formulaire affiche un message de
# configuration au lieu de simuler un envoi qui n'arrive nulle part.
PUBLIC_CONTACT_FORM_ENDPOINT=""
